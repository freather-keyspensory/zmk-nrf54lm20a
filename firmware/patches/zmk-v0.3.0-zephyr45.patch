diff --git a/app/src/behaviors/behavior_reset.c b/app/src/behaviors/behavior_reset.c
index 61df15a..a3b9921 100644
--- a/app/src/behaviors/behavior_reset.c
+++ b/app/src/behaviors/behavior_reset.c
@@ -13,6 +13,10 @@
 #include <drivers/behavior.h>
 
 #include <zmk/behavior.h>
+#include <dt-bindings/zmk/reset.h>
+#if IS_ENABLED(CONFIG_MINEW_UF2_BOOTLOADER)
+#include <zephyr/drivers/retained_mem.h>
+#endif
 
 LOG_MODULE_DECLARE(zmk, CONFIG_ZMK_LOG_LEVEL);
 
@@ -26,6 +30,20 @@ static int on_keymap_binding_pressed(struct zmk_behavior_binding *binding,
     const struct device *dev = zmk_behavior_get_binding(binding->behavior_dev);
     const struct behavior_reset_config *cfg = dev->config;
 
+#if IS_ENABLED(CONFIG_MINEW_UF2_BOOTLOADER)
+    if (cfg->type == RST_UF2) {
+        const struct device *retained = DEVICE_DT_GET(DT_NODELABEL(gpregret1));
+        const uint8_t request = 0xb1;
+        if (!device_is_ready(retained)) {
+            return -ENODEV;
+        }
+        int err = retained_mem_write(retained, 0, &request, sizeof(request));
+        if (err) {
+            return err;
+        }
+    }
+#endif
+
     // TODO: Correct magic code for going into DFU?
     // See
     // https://github.com/adafruit/Adafruit_nRF52_Bootloader/blob/d6b28e66053eea467166f44875e3c7ec741cb471/src/main.c#L107
