diff --git a/boot/bootutil/src/swap_scratch.c b/boot/bootutil/src/swap_scratch.c
index 7168098a..aaa64bb1 100644
--- a/boot/bootutil/src/swap_scratch.c
+++ b/boot/bootutil/src/swap_scratch.c
@@ -752,7 +752,9 @@ boot_swap_sectors(int idx, uint32_t sz, struct boot_loader_state *state,
 
     if (bs->state == BOOT_STATUS_STATE_0) {
         BOOT_LOG_DBG("erasing scratch area");
-        rc = boot_erase_region(fap_scratch, 0, flash_area_get_size(fap_scratch), false);
+        /* RRAM needs no physical erase, but stale scratch status must still
+         * be overwritten before it can be reused for another swap. */
+        rc = boot_scramble_region(fap_scratch, 0, flash_area_get_size(fap_scratch), true);
         assert(rc == 0);
 
         if (bs->idx == BOOT_STATUS_IDX_0) {
@@ -774,9 +776,9 @@ boot_swap_sectors(int idx, uint32_t sz, struct boot_loader_state *state,
                 rc = swap_status_init(state, fap_primary_slot, bs);
                 assert(rc == 0);
 
-                /* Erase the temporary trailer from the scratch area. */
-                rc = boot_erase_region(fap_scratch, 0,
-                        flash_area_get_size(fap_scratch), false);
+                /* Invalidate the temporary trailer on erase-free memory too. */
+                rc = boot_scramble_region(fap_scratch, 0,
+                        flash_area_get_size(fap_scratch), true);
                 assert(rc == 0);
             }
         }
